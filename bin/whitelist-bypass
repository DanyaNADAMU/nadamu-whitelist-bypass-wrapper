#!/usr/bin/env bash
#
# whitelist-bypass - Multi-account orchestrator for WhitelistBypass headless creators
#

set -euo pipefail

WLB_CONF_DIR="${WLB_CONF_DIR:-/etc/whitelist-bypass}"
WLB_BIN_DIR="${WLB_BIN_DIR:-/opt/whitelist-bypass/bin}"
USERS_DIR="$WLB_CONF_DIR/users"

# Formatting helpers
if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_RED="\033[31m"
    C_GREEN="\033[32m"
    C_YELLOW="\033[33m"
    C_CYAN="\033[36m"
else
    C_RESET=""
    C_BOLD=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_CYAN=""
fi

log_info()  { echo -e "${C_CYAN}[INFO]${C_RESET} $*"; }
log_ok()    { echo -e "${C_GREEN}[OK]${C_RESET} $*"; }
log_warn()  { echo -e "${C_YELLOW}[WARN]${C_RESET} $*" >&2; }
log_error() { echo -e "${C_RED}[ERROR]${C_RESET} $*" >&2; }

show_usage() {
    cat << "USAGE_EOF"
WhitelistBypass Multi-Account Orchestrator

Usage:
  whitelist-bypass <command> [options]

Room and Link Management:
  get-link, link <user> [--qr]         Show active conference room link and status
  qr <user>                            Display terminal QR code and link
  rotate <user> [--qr]                 Rotate conference room and persist new link
  set-provider <user> <provider> [--rotate]
                                       Change provider (telemost, vk, wbstream, dion)
  list                                 List all configured users and service statuses

Systemd Service Control:
  start <user>                         Start whitelist-bypass@<user> service
  stop <user>                          Stop whitelist-bypass@<user> service
  restart <user>                       Restart whitelist-bypass@<user> service
  status <user>                        Show systemd service status
  is-active <user>                     Check if service is active (active/inactive)

System Commands:
  run <user>                           Internal daemon runner (called by systemd)
  help                                 Show this help message

USAGE_EOF
}

render_qr() {
    local data="$1"
    if [[ -z "$data" ]]; then
        return 1
    fi

    if ! command -v qrencode >/dev/null 2>&1; then
        log_warn "Utility 'qrencode' not found in system."
        log_info "To enable in-terminal QR codes, install it via: sudo apt install -y qrencode"
        return 1
    fi

    local cols=80
    if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
        cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")
    fi

    if [[ "$cols" -lt 40 ]]; then
        log_warn "Terminal width ($cols cols) may be too narrow for QR rendering (recommended: 45+ cols)."
    fi

    echo ""
    # Render QR code using ANSIUTF8 with 2-module quiet zone margin
    qrencode -t ANSIUTF8 -m 2 "$data"
    echo ""
}

run_systemctl() {
    if [[ $EUID -eq 0 ]]; then
        systemctl "$@"
    else
        sudo systemctl "$@"
    fi
}

run_journalctl() {
    if [[ $EUID -eq 0 ]]; then
        journalctl "$@"
    else
        sudo journalctl "$@" 2>/dev/null || journalctl "$@"
    fi
}

validate_user() {
    local username="$1"
    if [[ -z "$username" ]]; then
        log_error "Username is required."
        exit 1
    fi

    local user_dir="$USERS_DIR/$username"
    if [[ ! -d "$user_dir" ]]; then
        log_error "User directory not found: $user_dir"
        exit 1
    fi
}

is_valid_cookie_file() {
    local file="$1"
    if [[ -f "$file" ]]; then
        local size
        size=$(wc -c < "$file" 2>/dev/null || echo 0)
        # Valid browser-exported JSON cookie array is typically > 15 bytes
        if [[ "$size" -gt 15 ]]; then
            return 0
        fi
    fi
    return 1
}

resolve_cookie_file() {
    local user_dir="$1"
    local provider="$2"

    local candidates=(
        "$user_dir/cookies-$provider.json"
    )

    if [[ "$provider" == "telemost" ]]; then
        candidates+=("$user_dir/cookies-yandex.json")
    fi

    candidates+=("$user_dir/cookies.json")

    # 1. Prefer files with actual content (>15 bytes)
    for file in "${candidates[@]}"; do
        if is_valid_cookie_file "$file"; then
            echo "$file"
            return 0
        fi
    done

    # 2. Fallback to any existing file so caller can detect and report stub/empty file
    for file in "${candidates[@]}"; do
        if [[ -f "$file" ]]; then
            echo "$file"
            return 0
        fi
    done

    return 1
}

cmd_run() {
    local username="$1"
    validate_user "$username"

    local user_dir="$USERS_DIR/$username"
    local conf_file="$user_dir/user.conf"
    local room_env="$user_dir/room.env"
    local current_link_file="$user_dir/current_link"

    local PROVIDER="telemost"
    local RESOURCES="default"
    local UPSTREAM_SOCKS=""
    local UPSTREAM_USER=""
    local UPSTREAM_PASS=""
    local DISPLAY_NAME="Headless"
    local PEER_ID=""
    local ALLOW_PRIVATE_DST="false"
    local DEBUG="false"

    if [[ -f "$conf_file" ]]; then
        # shellcheck disable=SC1090
        source "$conf_file"
    fi

    local cookie_file
    if ! cookie_file=$(resolve_cookie_file "$user_dir" "$PROVIDER"); then
        log_error "Cookie file for provider '$PROVIDER' not found in $user_dir"
        log_error "Expected: cookies-$PROVIDER.json or cookies.json"
        exit 1
    fi

    if ! is_valid_cookie_file "$cookie_file"; then
        local sz
        sz=$(wc -c < "$cookie_file" 2>/dev/null | tr -d ' ' || echo 0)
        log_error "Cookie file '$cookie_file' is empty or an unpopulated stub ($sz bytes)."
        log_error "To use provider '$PROVIDER', export valid authenticated session cookies from your browser."
        exit 1
    fi

    local binary_name=""
    case "$PROVIDER" in
        telemost) binary_name="headless-telemost-creator" ;;
        vk)       binary_name="headless-vk-creator" ;;
        wbstream) binary_name="headless-wbstream-creator" ;;
        dion)     binary_name="headless-dion-creator" ;;
        *)
            log_error "Unknown provider: '$PROVIDER'. Supported: telemost, vk, wbstream, dion"
            exit 1
            ;;
    esac

    local binary_path="$WLB_BIN_DIR/$binary_name"
    if [[ ! -x "$binary_path" ]]; then
        log_error "Binary $binary_path not found or lacks executable permissions."
        exit 1
    fi

    local CALL_LINK=""
    if [[ -f "$room_env" ]]; then
        # shellcheck disable=SC1090
        source "$room_env"
        CALL_LINK="${CALL_LINK:-${TM_LINK:-}}"
    fi

    local args=()
    args+=("--cookies" "$cookie_file")
    args+=("--write-file" "$current_link_file")
    args+=("--resources" "$RESOURCES")

    if [[ -n "$UPSTREAM_SOCKS" ]]; then
        args+=("--upstream-socks" "$UPSTREAM_SOCKS")
    fi
    if [[ -n "$UPSTREAM_USER" ]]; then
        args+=("--upstream-user" "$UPSTREAM_USER")
    fi
    if [[ -n "$UPSTREAM_PASS" ]]; then
        args+=("--upstream-pass" "$UPSTREAM_PASS")
    fi
    if [[ "$DEBUG" == "true" || "$DEBUG" == "1" ]]; then
        args+=("--debug")
    fi
    if [[ "$ALLOW_PRIVATE_DST" == "true" || "$ALLOW_PRIVATE_DST" == "1" ]]; then
        args+=("--allow-private-dst")
    fi

    case "$PROVIDER" in
        telemost)
            if [[ -n "$CALL_LINK" ]]; then
                args+=("--tm-link" "$CALL_LINK")
            fi
            ;;
        vk)
            if [[ -n "$CALL_LINK" ]]; then
                args+=("--vk-link" "$CALL_LINK")
            fi
            if [[ -n "$PEER_ID" ]]; then
                args+=("--peer-id" "$PEER_ID")
            fi
            ;;
        wbstream|dion)
            if [[ -n "$CALL_LINK" ]]; then
                args+=("--room" "$CALL_LINK")
            fi
            if [[ -n "$DISPLAY_NAME" ]]; then
                args+=("--name" "$DISPLAY_NAME")
            fi
            ;;
    esac

    rm -f "$current_link_file"
    touch "$current_link_file"
    chmod 644 "$current_link_file" 2>/dev/null || true

    log_info "Starting $binary_name for user $username (provider: $PROVIDER)..."
    exec "$binary_path" "${args[@]}"
}

cmd_get_link() {
    local username=""
    local show_qr=false

    for arg in "$@"; do
        case "$arg" in
            --qr|-q)
                show_qr=true
                ;;
            *)
                if [[ -z "$username" ]]; then
                    username="$arg"
                fi
                ;;
        esac
    done

    if [[ -z "$username" ]]; then
        log_error "Username is required."
        log_error "Usage: whitelist-bypass get-link <user> [--qr]"
        exit 1
    fi

    validate_user "$username"

    local user_dir="$USERS_DIR/$username"
    local room_env="$user_dir/room.env"
    local current_link_file="$user_dir/current_link"
    local conf_file="$user_dir/user.conf"

    local PROVIDER="telemost"
    if [[ -f "$conf_file" ]]; then
        # shellcheck disable=SC1090
        source "$conf_file"
    fi
    local provider="$PROVIDER" 

    local service_status="inactive"
    if command -v systemctl >/dev/null 2>&1; then
        service_status=$(run_systemctl is-active "whitelist-bypass@$username" 2>/dev/null || true)
        service_status="${service_status:-inactive}"
    fi

    local link=""
    if [[ -f "$room_env" ]]; then
        # shellcheck disable=SC1090
        source "$room_env"
        link="${CALL_LINK:-${TM_LINK:-}}"
    elif [[ -f "$current_link_file" ]]; then
        link=$(tail -n 1 "$current_link_file" 2>/dev/null || true)
    fi

    if [[ -n "$link" ]]; then
        if [[ "$show_qr" == "true" ]]; then
            render_qr "$link" || true
        fi
        echo "User:     $username"
        echo "Provider: $provider"
        echo "Service:  $service_status"
        echo "Link:     $link"
    else
        log_warn "Conference link has not been provisioned yet for user $username."
        log_warn "Run room rotation: whitelist-bypass rotate $username"
        exit 2
    fi
}

cmd_rotate() {
    local username=""
    local show_qr=false

    for arg in "$@"; do
        case "$arg" in
            --qr|-q)
                show_qr=true
                ;;
            *)
                if [[ -z "$username" ]]; then
                    username="$arg"
                fi
                ;;
        esac
    done

    if [[ -z "$username" ]]; then
        log_error "Username is required."
        log_error "Usage: whitelist-bypass rotate <user> [--qr]"
        exit 1
    fi

    validate_user "$username"

    local user_dir="$USERS_DIR/$username"
    local room_env="$user_dir/room.env"
    local current_link_file="$user_dir/current_link"
    local service_name="whitelist-bypass@$username"

    log_info "Rotating conference room for $username..."

    if command -v systemctl >/dev/null 2>&1; then
        log_info "Stopping service $service_name..."
        run_systemctl stop "$service_name" 2>/dev/null || true
    fi

    rm -f "$room_env" "$current_link_file"

    log_info "Starting service $service_name to generate a new room..."
    if command -v systemctl >/dev/null 2>&1; then
        run_systemctl start "$service_name"
    else
        log_error "systemctl is unavailable. Room rotation requires an active systemd environment."
        exit 1
    fi

    log_info "Waiting for media server to provision conference room..."
    local timeout=20
    local waited=0
    local new_link=""

    while [[ $waited -lt $((timeout * 5)) ]]; do
        if [[ -s "$current_link_file" ]]; then
            new_link=$(tail -n 1 "$current_link_file" | tr -d "\r\n")
            if [[ -n "$new_link" ]]; then
                break
            fi
        fi

        if ! run_systemctl is-active "$service_name" >/dev/null 2>&1; then
            log_error "Service $service_name exited prematurely during room generation!"
            if command -v journalctl >/dev/null 2>&1; then
                run_journalctl -u "$service_name" -n 15 --no-pager >&2 || true
            fi
            exit 1
        fi

        sleep 0.2
        waited=$((waited + 1))
    done

    if [[ -z "$new_link" ]]; then
        log_error "Timeout (${timeout}s) waiting for room link from media server."
        if command -v journalctl >/dev/null 2>&1; then
            run_journalctl -u "$service_name" -n 15 --no-pager >&2 || true
        fi
        exit 1
    fi

    echo "CALL_LINK=\"$new_link\"" > "$room_env"
    chmod 600 "$room_env"

    log_ok "New room successfully provisioned and persisted:"
    if [[ "$show_qr" == "true" ]]; then
        render_qr "$new_link" || true
    fi
    echo "$new_link"
}

cmd_set_provider() {
    local username=""
    local new_provider=""
    local do_rotate=false

    for arg in "$@"; do
        case "$arg" in
            --rotate|-r)
                do_rotate=true
                ;;
            telemost|vk|wbstream|dion)
                new_provider="$arg"
                ;;
            *)
                if [[ -z "$username" ]]; then
                    username="$arg"
                fi
                ;;
        esac
    done

    if [[ -z "$username" || -z "$new_provider" ]]; then
        log_error "Usage: whitelist-bypass set-provider <user> <telemost|vk|wbstream|dion> [--rotate]"
        exit 1
    fi

    validate_user "$username"

    local user_dir="$USERS_DIR/$username"
    local conf_file="$user_dir/user.conf"

    # Check for provider cookies
    local cookie_file
    if ! cookie_file=$(resolve_cookie_file "$user_dir" "$new_provider") || ! is_valid_cookie_file "$cookie_file"; then
        local sz=0
        if [[ -n "${cookie_file:-}" && -f "$cookie_file" ]]; then
            sz=$(wc -c < "$cookie_file" 2>/dev/null | tr -d ' ' || echo 0)
        fi
        log_warn "Cookie file for provider '$new_provider' is missing or unpopulated in $user_dir!"
        if [[ "$sz" -gt 0 ]]; then
            log_warn "Current file '$(basename "$cookie_file")' has size $sz bytes (empty stub)."
        fi
        log_warn "Populate 'cookies-$new_provider.json' with valid authenticated session cookies before running."
    fi

    # Update or add PROVIDER in user.conf
    if [[ -f "$conf_file" ]]; then
        if grep -qE "^PROVIDER=" "$conf_file"; then
            sed -i "s/^PROVIDER=.*/PROVIDER=$new_provider/" "$conf_file"
        else
            echo "PROVIDER=$new_provider" >> "$conf_file"
        fi
    else
        echo "PROVIDER=$new_provider" > "$conf_file"
        chmod 600 "$conf_file"
    fi

    log_ok "Provider for user '$username' changed to '$new_provider'."

    if [[ "$do_rotate" == "true" ]]; then
        cmd_rotate "$username" "--qr"
    else
        log_info "To apply changes and provision a new room, execute:"
        log_info "  whitelist-bypass rotate $username --qr"
    fi
}

cmd_list() {
    if [[ ! -d "$USERS_DIR" ]]; then
        log_info "User directory $USERS_DIR is empty or does not exist."
        return 0
    fi

    printf "%-18s %-12s %-12s %s\n" "USER" "PROVIDER" "STATUS" "ACTIVE LINK"
    printf "%-18s %-12s %-12s %s\n" "------------------" "------------" "------------" "----------------------------------------"

    local found=0
    for udir in "$USERS_DIR"/*; do
        if [[ -d "$udir" ]]; then
            found=1
            local uname
            uname=$(basename "$udir")
            local conf_file="$udir/user.conf"
            local room_env="$udir/room.env"
            local current_link_file="$udir/current_link"

            local PROVIDER="telemost"
            if [[ -f "$conf_file" ]]; then
                # shellcheck disable=SC1090
                source "$conf_file"
            fi
            local provider="$PROVIDER" 

            local status="inactive"
            if command -v systemctl >/dev/null 2>&1; then
                status=$(run_systemctl is-active "whitelist-bypass@$uname" 2>/dev/null || true)
                status="${status:-inactive}"
            fi

            local link="—"
            if [[ -f "$room_env" ]]; then
                # shellcheck disable=SC1090
                source "$room_env"
                link="${CALL_LINK:-${TM_LINK:-—}}"
            elif [[ -f "$current_link_file" ]]; then
                link=$(tail -n 1 "$current_link_file" 2>/dev/null || echo "—")
            fi

            printf "%-18s %-12s %-12s %s\n" "$uname" "$provider" "$status" "$link"
        fi
    done

    if [[ $found -eq 0 ]]; then
        echo "No configured users found in $USERS_DIR"
    fi
}

cmd_systemctl() {
    local action="$1"
    local username="$2"
    validate_user "$username"

    local service_name="whitelist-bypass@$username"
    case "$action" in
        start|stop|restart|status|is-active)
            run_systemctl "$action" "$service_name"
            ;;
        *)
            log_error "Unknown systemctl action: $action"
            exit 1
            ;;
    esac
}

main() {
    if [[ $# -lt 1 ]]; then
        show_usage
        exit 1
    fi

    local action="$1"
    shift

    case "$action" in
        help|-h|--help)
            show_usage
            ;;
        run)
            if [[ $# -lt 1 ]]; then
                log_error "Usage: whitelist-bypass run <user>"
                exit 1
            fi
            cmd_run "$1"
            ;;
        get-link|link)
            if [[ $# -lt 1 ]]; then
                log_error "Usage: whitelist-bypass get-link <user> [--qr]"
                exit 1
            fi
            cmd_get_link "$@"
            ;;
        qr)
            if [[ $# -lt 1 ]]; then
                log_error "Usage: whitelist-bypass qr <user>"
                exit 1
            fi
            cmd_get_link "$@" "--qr"
            ;;
        rotate)
            if [[ $# -lt 1 ]]; then
                log_error "Usage: whitelist-bypass rotate <user> [--qr]"
                exit 1
            fi
            cmd_rotate "$@"
            ;;
        set-provider)
            if [[ $# -lt 2 ]]; then
                log_error "Usage: whitelist-bypass set-provider <user> <telemost|vk|wbstream|dion> [--rotate]"
                exit 1
            fi
            cmd_set_provider "$@"
            ;;
        list)
            cmd_list
            ;;
        start|stop|restart|status|is-active)
            if [[ $# -lt 1 ]]; then
                log_error "Usage: whitelist-bypass $action <user>"
                exit 1
            fi
            cmd_systemctl "$action" "$1"
            ;;
        *)
            log_error "Unknown command: '$action'"
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
