#!/usr/bin/env bash
#
# whitelist-bypass - Multi-account orchestrator for WhitelistBypass headless creators
# Unified CLI entrypoint delegating to the Python core engine
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd || echo "")"

# Resolve Python package search path
if [[ -d "$REPO_ROOT/core" ]]; then
    export PYTHONPATH="$REPO_ROOT:${PYTHONPATH:-}"
fi
if [[ -d "/opt/whitelist-bypass" ]]; then
    export PYTHONPATH="/opt/whitelist-bypass:${PYTHONPATH:-}"
fi

# Select Python interpreter: prefer production virtualenv
PYTHON_BIN="python3"
if [[ -x "/opt/whitelist-bypass/venv/bin/python3" ]]; then
    PYTHON_BIN="/opt/whitelist-bypass/venv/bin/python3"
fi

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    echo "[ERROR] Python 3 interpreter not found in system or venv." >&2
    exit 1
fi

exec "$PYTHON_BIN" -m core.cli "$@"
