# Bash completion for whitelist-bypass
# Place in /etc/bash_completion.d/whitelist-bypass
# or /usr/share/bash-completion/completions/whitelist-bypass

_whitelist_bypass() {
    local cur prev words cword
    if type _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        cword=$COMP_CWORD
    fi

    local commands="get-link link qr rotate list start stop restart status is-active run help"
    local user_commands="get-link link qr rotate start stop restart status is-active run"

    # Complete main command
    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi

    # Complete options and usernames for subcommands
    local cmd="${COMP_WORDS[1]}"
    if [[ " $user_commands " =~ [[:space:]]${cmd}[[:space:]] ]]; then
        local conf_dir="${WLB_CONF_DIR:-/etc/whitelist-bypass}"
        local users_dir="$conf_dir/users"
        local user_list=""
        if [[ -d "$users_dir" ]]; then
            user_list=$(find "$users_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || \
                        for d in "$users_dir"/*/; do [[ -d "$d" ]] && basename "$d"; done)
        fi

        case "$cmd" in
            get-link|link|rotate)
                COMPREPLY=($(compgen -W "$user_list --qr" -- "$cur"))
                ;;
            *)
                COMPREPLY=($(compgen -W "$user_list" -- "$cur"))
                ;;
        esac
        return 0
    fi
}

complete -F _whitelist_bypass whitelist-bypass
