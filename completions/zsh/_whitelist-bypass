#compdef whitelist-bypass

_whitelist_bypass_users() {
    local conf_dir="${WLB_CONF_DIR:-/etc/whitelist-bypass}"
    local users_dir="$conf_dir/users"
    if [[ -d "$users_dir" ]]; then
        local -a users
        users=(${users_dir}/*(N/:t))
        if (( ${#users} > 0 )); then
            _describe 'user' users
        fi
    fi
}

_whitelist_bypass() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a commands=(
        'get-link:Show active conference room link and status'
        'link:Show active conference room link and status'
        'qr:Display terminal QR code and link'
        'rotate:Rotate conference room and persist new link'
        'set-provider:Change WebRTC provider (telemost, vk, wbstream, dion)'
        'list:List all configured users and service statuses'
        'start:Start tunnel service'
        'stop:Stop tunnel service'
        'restart:Restart tunnel service'
        'status:Show systemd service status'
        'is-active:Check if tunnel service is active'
        'run:Internal creator daemon launcher (systemd)'
        'help:Show help summary'
    )

    _arguments -C \
        '1: :->command' \
        '*: :->argument'

    case $state in
        command)
            _describe 'command' commands
            ;;
        argument)
            case $words[2] in
                get-link|link|rotate)
                    local -a opts
                    opts=('--qr:Display conference link as terminal QR code')
                    _describe 'option' opts
                    _whitelist_bypass_users
                    ;;
                set-provider)
                    local -a providers
                    providers=(
                        'telemost:Yandex.Telemost'
                        'vk:VK Calls'
                        'wbstream:WB Stream'
                        'dion:DION'
                        '--rotate:Automatically provision a new room and display QR code'
                    )
                    _whitelist_bypass_users
                    _describe 'provider / option' providers
                    ;;
                qr|start|stop|restart|status|is-active|run)
                    _whitelist_bypass_users
                    ;;
            esac
            ;;
    esac
}

_whitelist_bypass "$@"
