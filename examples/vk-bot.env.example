# WhitelistBypass / Iris VK Bot Configuration
# Location: /etc/whitelist-bypass/vk-bot.env

# VK Community Access Token
# Create via: Community -> Manage -> API usage -> Access tokens
# Required scopes: "Manage community" and "Community messages"
VK_GROUP_TOKEN="vk1.a.YourCommunityAccessTokenHere..."

# VK Community ID (positive integer, without minus sign)
VK_GROUP_ID=123456789

# Comma-separated list of administrator VK user IDs
VK_ADMIN_IDS="12345678,98765432"

# Default interface language (ru or en)
VK_DEFAULT_LANG="ru"
