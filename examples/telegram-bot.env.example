# Configuration for WhitelistBypass Telegram Bot
# Place in /etc/whitelist-bypass/telegram-bot.env (mode 0600)

# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Comma-separated Telegram User IDs of administrators
# Administrators can use /list and manage any user by passing their name: /link <user>, /rotate <user>
ADMIN_IDS="123456789"

# Default interface language (ru or en)
DEFAULT_LANG="ru"
